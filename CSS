/* =========================
   SECTION HEADINGS
========================= */

.content-section{
    min-height:100vh;
    padding:120px 25px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
}

.section-heading{
    text-align:center;
    max-width:700px;
    margin-bottom:65px;
}

.section-number{
    font-size:10px;
    letter-spacing:5px;
    color:#9e4b5b;
    text-transform:uppercase;
    margin-bottom:15px;
}

.section-heading h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(50px,8vw,85px);
    font-weight:500;
    line-height:.9;
}

.section-heading h2 span{
    color:#a71936;
    font-style:italic;
}

.section-heading p:last-child{
    margin-top:22px;
    color:#927b80;
    line-height:1.8;
}


/* =========================
   LETTER
========================= */

.letter-wrapper{
    width:min(850px,100%);
    position:relative;
}

.letter{
    position:relative;
    padding:70px 65px;
    background:
        linear-gradient(
            135deg,
            rgba(75,5,15,.55),
            rgba(25,2,7,.72)
        );
    border:1px solid rgba(180,45,70,.25);
    border-radius:4px;
    box-shadow:
        0 35px 100px rgba(0,0,0,.5),
        inset 0 0 80px rgba(140,0,30,.06);
    overflow:hidden;
}

.letter::before{
    content:"";
    position:absolute;
    inset:15px;
    border:1px solid rgba(180,45,70,.12);
    pointer-events:none;
}

.letter::after{
    content:"❦";
    position:absolute;
    top:25px;
    right:35px;
    color:#9d2942;
    font-size:25px;
    opacity:.7;
}

.letter-date{
    font-size:10px;
    letter-spacing:3px;
    color:#8d6870;
    text-transform:uppercase;
    margin-bottom:35px;
}

.letter h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(40px,6vw,65px);
    font-weight:500;
    margin-bottom:35px;
}

.letter h2 span{
    color:#b51d3b;
    font-style:italic;
}

.letter-body{
    color:#d5c2c6;
    line-height:2;
    font-size:15px;
}

.letter-body p{
    margin-bottom:22px;
}

.letter-signature{
    margin-top:45px;
    font-family:'Cormorant Garamond',serif;
    font-size:30px;
    color:#d99aa6;
    font-style:italic;
}


/* =========================
   REASONS
========================= */

.reasons-section{
    min-height:100vh;
    padding:120px 25px;
}

.reason-container{
    width:min(900px,100%);
}

.reason-list{
    display:grid;
    gap:14px;
}

.reason-item{
    display:grid;
    grid-template-columns:55px 1fr;
    gap:20px;
    align-items:center;

    padding:23px 25px;

    background:rgba(55,3,12,.35);
    border:1px solid rgba(180,40,65,.13);
    border-radius:12px;

    transition:
        transform .4s ease,
        background .4s ease,
        border-color .4s ease;
}

.reason-item:hover{
    transform:translateX(10px);
    background:rgba(90,5,20,.42);
    border-color:rgba(190,50,75,.4);
}

.reason-number{
    font-family:'Cormorant Garamond',serif;
    font-size:24px;
    color:#8f2b42;
}

.reason-item p{
    color:#cbb9bd;
    line-height:1.6;
    font-size:14px;
}


/* =========================
   MEMORIES
========================= */

.memories{
    min-height:100vh;
    padding:120px 25px;
}

.memory-grid{
    width:min(1000px,100%);
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:22px;
}

.memory{
    position:relative;
    min-height:350px;
    border-radius:20px;
    overflow:hidden;
    border:1px solid rgba(180,40,65,.25);
    background:#160408;
    cursor:pointer;

    box-shadow:0 20px 60px rgba(0,0,0,.35);

    transition:
        transform .5s ease,
        box-shadow .5s ease;
}

.memory:hover{
    transform:translateY(-10px) scale(1.015);
    box-shadow:
        0 30px 80px rgba(100,0,20,.35);
}

.memory img{
    width:100%;
    height:100%;
    min-height:350px;
    object-fit:cover;
    display:block;

    filter:saturate(.85);
    transition:
        transform .8s ease,
        filter .8s ease;
}

.memory:hover img{
    transform:scale(1.07);
    filter:saturate(1);
}

.memory-overlay{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;

    padding:30px;

    background:
        linear-gradient(
            transparent 35%,
            rgba(8,0,3,.9)
        );
}

.memory-overlay span{
    font-size:10px;
    letter-spacing:3px;
    text-transform:uppercase;
    color:#c87988;
    margin-bottom:8px;
}

.memory-overlay h3{
    font-family:'Cormorant Garamond',serif;
    font-size:32px;
    font-weight:500;
}


/* =========================
   VIDEO MEMORY
========================= */

.video-memory{
    width:min(850px,100%);
    margin-top:25px;
    border-radius:22px;
    overflow:hidden;
    border:1px solid rgba(180,40,65,.25);
    background:#100205;
    box-shadow:0 30px 90px rgba(0,0,0,.45);
}

.video-memory video{
    width:100%;
    display:block;
    max-height:650px;
    object-fit:contain;
    background:#050103;
}


/* =========================
   FINAL SURPRISE
========================= */

.final-section{
    min-height:100vh;
    padding:100px 25px;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
}

.final-box{
    width:min(750px,100%);
    padding:80px 40px;
    position:relative;

    border:1px solid rgba(180,40,65,.25);
    border-radius:30px;

    background:
        radial-gradient(
            circle at center,
            rgba(130,0,30,.18),
            transparent 65%
        ),
        rgba(35,2,8,.45);

    box-shadow:
        0 40px 100px rgba(0,0,0,.5);

    overflow:hidden;
}

.final-symbol{
    font-size:65px;
    margin-bottom:30px;
    animation:heartbeat 2.2s ease-in-out infinite;
}

@keyframes heartbeat{
    0%,100%{
        transform:scale(1);
    }

    50%{
        transform:scale(1.12);
    }
}

.final-box h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(50px,8vw,80px);
    font-weight:500;
}

.final-box h2 span{
    display:block;
    color:#a71936;
    font-style:italic;
}

.final-box p{
    max-width:500px;
    margin:25px auto 35px;
    color:#bca6aa;
    line-height:1.9;
}

.surprise-button{
    padding:16px 34px;
    border-radius:100px;

    color:white;
    background:linear-gradient(
        135deg,
        #761329,
        #a71936
    );

    border:1px solid rgba(255,255,255,.15);
    cursor:pointer;

    box-shadow:
        0 10px 35px rgba(130,0,30,.3);

    transition:.4s ease;
}

.surprise-button:hover{
    transform:translateY(-5px) scale(1.04);
    box-shadow:
        0 15px 50px rgba(170,0,40,.45);
}


/* =========================
   SURPRISE MODAL
========================= */

.modal{
    position:fixed;
    inset:0;
    z-index:100;

    display:flex;
    align-items:center;
    justify-content:center;

    padding:25px;

    background:rgba(5,0,2,.85);
    backdrop-filter:blur(18px);

    opacity:0;
    pointer-events:none;

    transition:.5s ease;
}

.modal.active{
    opacity:1;
    pointer-events:auto;
}

.modal-box{
    width:min(650px,100%);
    padding:65px 40px;
    text-align:center;

    background:
        radial-gradient(
            circle at center,
            rgba(130,0,30,.2),
            transparent 65%
        ),
        #160307;

    border:1px solid rgba(190,45,70,.35);
    border-radius:25px;

    transform:scale(.85) translateY(20px);
    transition:.5s ease;

    box-shadow:
        0 40px 120px rgba(0,0,0,.7);
}

.modal.active .modal-box{
    transform:scale(1) translateY(0);
}

.modal-box .heart{
    font-size:55px;
    margin-bottom:20px;
}

.modal-box h2{
    font-family:'Cormorant Garamond',serif;
    font-size:55px;
    font-weight:500;
}

.modal-box p{
    margin-top:20px;
    color:#c9b5b9;
    line-height:1.9;
}

.close-modal{
    margin-top:30px;
    padding:11px 25px;
    border-radius:50px;
    color:white;
    background:rgba(255,255,255,.07);
    border:1px solid rgba(255,255,255,.15);
    cursor:pointer;
    transition:.3s;
}

.close-modal:hover{
    background:rgba(255,255,255,.13);
}


/* =========================
   PHOTO LIGHTBOX
========================= */

.lightbox{
    position:fixed;
    inset:0;
    z-index:110;

    display:flex;
    justify-content:center;
    align-items:center;

    padding:20px;

    background:rgba(0,0,0,.9);
    backdrop-filter:blur(15px);

    opacity:0;
    pointer-events:none;
    transition:.4s ease;
}

.lightbox.active{
    opacity:1;
    pointer-events:auto;
}

.lightbox img{
    max-width:95%;
    max-height:90vh;
    border-radius:12px;
    box-shadow:0 30px 100px rgba(0,0,0,.7);
}

.close-lightbox{
    position:absolute;
    top:25px;
    right:30px;

    width:45px;
    height:45px;
    border-radius:50%;

    background:rgba(255,255,255,.1);
    color:white;
    border:1px solid rgba(255,255,255,.2);

    font-size:22px;
    cursor:pointer;
}


/* =========================
   FOOTER
========================= */

footer{
    padding:80px 25px;
    text-align:center;
    border-top:1px solid rgba(180,40,65,.1);
}

footer p{
    color:#745c61;
    font-size:11px;
    letter-spacing:2px;
}

footer span{
    color:#9f2942;
}


/* =========================
   MOBILE
========================= */

@media(max-width:700px){

    .letter{
        padding:50px 28px;
    }

    .letter::before{
        inset:10px;
    }

    .reason-item{
        grid-template-columns:40px 1fr;
        padding:20px 17px;
    }

    .memory-grid{
        grid-template-columns:1fr;
    }

    .memory,
    .memory img{
        min-height:300px;
    }

    .countdown{
        gap:8px;
    }

    .time-box{
        width:78px;
        height:78px;
    }

    .time-box span{
        font-size:23px;
    }

    .final-box{
        padding:60px 25px;
    }
}
